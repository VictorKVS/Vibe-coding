# OpenAI — never commit a real key.
OPENAI_API_KEY=
OPENAI_MODELS=gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol

# GigaChat API — store only the Authorization key from the GigaChat API project.
# The server exchanges it for a short-lived access token and caches that token in memory.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODELS=
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_BASE_URL=https://api.giga.chat/v1

# Any OpenAI-compatible endpoint (for example OpenRouter, LM Studio, vLLM, a company gateway).
# Base URL must end before /chat/completions, for example https://openrouter.ai/api/v1
COMPATIBLE_BASE_URL=
COMPATIBLE_API_KEY=
COMPATIBLE_MODELS=
COMPATIBLE_LABEL=OpenAI-compatible
COMPATIBLE_SITE_URL=
COMPATIBLE_APP_NAME=Wild Ideas

# Ollama. Localhost works only when the app server can reach the same machine.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODELS=
