{
  "schema_version": "alina-analyst-method-cards-v1",
  "methods": [
    {
      "id": "METHOD-PLAN-001",
      "name": "Analysis Planning",
      "goal": "Разложить аналитический запрос на проверяемые подзадачи и определить требуемые типы evidence.",
      "inputs": ["analysis_request", "domain_profile", "kb_scope"],
      "outputs": ["analysis_plan", "required_evidence_types", "stop_conditions"],
      "source_refs": ["STD-RU-71540-2024", "STD-ISO-42001-2024-RU"],
      "checks": ["scope_defined", "no_unbounded_search", "review_threshold_defined"],
      "failure_modes": ["scope_drift", "goal_substitution", "premature_conclusion"],
      "explanation_requirements": ["show_plan", "show_scope", "show_required_evidence"],
      "status": "draft"
    },
    {
      "id": "METHOD-RETRIEVE-001",
      "name": "Evidence Retrieval",
      "goal": "Получить из KB релевантные записи и связанные provenance без потери контекста.",
      "inputs": ["analysis_plan", "kb_index", "query"],
      "outputs": ["retrieved_records", "retrieval_trace"],
      "source_refs": ["BOOK-MANNING-IR", "W3C-PROV-O"],
      "checks": ["provenance_present", "query_logged", "coverage_estimated"],
      "metrics": ["precision_at_k", "recall_estimate", "source_coverage"],
      "failure_modes": ["retrieval_bias", "context_loss", "duplicate_overweighting"],
      "explanation_requirements": ["show_queries", "show_selected_records", "show_why_selected"],
      "status": "draft"
    },
    {
      "id": "METHOD-SOURCE-QUALITY-001",
      "name": "Source and Data Quality Assessment",
      "goal": "Оценить пригодность, происхождение и качество используемых данных до аналитического вывода.",
      "inputs": ["source_records", "captures", "fragments"],
      "outputs": ["source_quality_profile", "data_quality_flags"],
      "source_refs": ["STD-RU-71484-1-2024", "STD-RU-71484-2-2024", "STD-RU-71484-3-2024", "STD-RU-71484-4-2024", "STD-RU-72663-2026", "BOOK-BATINI-DIQ"],
      "checks": ["origin_known", "integrity_known", "completeness_considered", "timeliness_considered"],
      "metrics": ["completeness", "consistency", "accuracy_proxy", "timeliness", "provenance_quality"],
      "failure_modes": ["unknown_origin", "stale_data", "partial_capture", "corrupted_source"],
      "explanation_requirements": ["show_quality_factors", "show_data_limitations"],
      "status": "draft"
    },
    {
      "id": "METHOD-ENTITY-RESOLUTION-001",
      "name": "Entity Resolution",
      "goal": "Определить, относятся ли различные упоминания к одной сущности, без скрытого объединения.",
      "inputs": ["entity_mentions", "context", "aliases", "relations"],
      "outputs": ["entity_resolution_candidates", "merge_decisions"],
      "source_refs": ["BOOK-HOGAN-KG", "BOOK-BATINI-DIQ", "BOOK-JURAFSKY-MARTIN"],
      "checks": ["aliases_preserved", "merge_reversible", "evidence_for_merge_present"],
      "metrics": ["precision", "recall", "merge_error_rate"],
      "failure_modes": ["false_merge", "false_split", "alias_collision"],
      "explanation_requirements": ["show_mentions", "show_similarity_factors", "show_merge_confidence"],
      "status": "draft"
    },
    {
      "id": "METHOD-CLAIM-FACT-001",
      "name": "Claim / Fact Separation",
      "goal": "Не допускать автоматического превращения утверждения источника или интерпретации модели в факт.",
      "inputs": ["claims", "evidence", "source_quality_profile"],
      "outputs": ["classified_claims", "fact_candidates"],
      "source_refs": ["STD-RU-71540-2024", "W3C-PROV-O", "BOOK-HOGAN-KG"],
      "checks": ["claim_not_equal_fact", "provenance_present", "independence_checked"],
      "failure_modes": ["source_claim_promoted_to_fact", "model_output_used_as_evidence", "circular_support"],
      "explanation_requirements": ["show_claim_source", "show_supporting_evidence", "show_status_reason"],
      "status": "draft"
    },
    {
      "id": "METHOD-CONTRADICTION-001",
      "name": "Contradiction Detection",
      "goal": "Выявить несовместимые утверждения, факты, временные или причинные связи и сохранить конфликт явно.",
      "inputs": ["claims", "facts", "relations", "events", "timeline"],
      "outputs": ["contradictions", "conflict_clusters"],
      "source_refs": ["BOOK-HOGAN-KG", "BOOK-JURAFSKY-MARTIN"],
      "checks": ["same_scope_checked", "same_entity_checked", "time_context_checked", "no_silent_resolution"],
      "metrics": ["contradiction_precision", "contradiction_recall"],
      "failure_modes": ["false_conflict", "missed_conflict", "scope_mismatch"],
      "explanation_requirements": ["show_conflicting_records", "show_conflict_type", "show_unresolved_status"],
      "status": "draft"
    },
    {
      "id": "METHOD-HYPOTHESIS-001",
      "name": "Competing Hypotheses",
      "goal": "Строить несколько объяснений при недостаточной определённости и оценивать evidence за и против каждого.",
      "inputs": ["evidence_set", "contradictions", "open_questions"],
      "outputs": ["hypothesis_set", "support_map", "counter_evidence_map"],
      "source_refs": ["BOOK-KOLLER-FRIEDMAN", "BOOK-PEARL-CAUSALITY", "STD-RU-59276-2020"],
      "checks": ["multiple_alternatives_considered", "counter_evidence_searched", "hypothesis_not_promoted_to_fact"],
      "metrics": ["evidence_coverage", "counter_evidence_coverage", "review_correction_rate"],
      "failure_modes": ["single_story_bias", "confirmation_bias", "unsupported_hypothesis"],
      "explanation_requirements": ["show_alternatives", "show_for_and_against", "show_open_questions"],
      "status": "draft"
    },
    {
      "id": "METHOD-CONFIDENCE-001",
      "name": "Explainable Confidence",
      "goal": "Формировать confidence как разложение наблюдаемых факторов, а не как произвольное число модели.",
      "inputs": ["source_quality_profile", "provenance", "agreement", "counter_evidence", "missing_data", "extraction_quality"],
      "outputs": ["confidence_breakdown"],
      "source_refs": ["STD-RU-71484-2-2024", "STD-RU-72663-2026", "STD-RU-59276-2020", "BOOK-KOLLER-FRIEDMAN"],
      "checks": ["factors_exposed", "calibration_status_exposed", "no_fake_precision"],
      "metrics": ["calibration_error", "brier_score_when_applicable", "review_agreement"],
      "failure_modes": ["llm_self_score", "uncalibrated_precision", "hidden_penalty"],
      "explanation_requirements": ["show_factor_breakdown", "show_calibration_status"],
      "status": "draft"
    },
    {
      "id": "METHOD-PROVENANCE-001",
      "name": "Provenance Trace",
      "goal": "Связать каждый вывод и изменение KB с источником, фрагментом, действием, агентом и версией.",
      "inputs": ["sources", "fragments", "analyst_actions", "outputs"],
      "outputs": ["provenance_graph", "trace_links"],
      "source_refs": ["W3C-PROV-O", "STD-RU-70889-2023", "STD-RU-58545-2019"],
      "checks": ["source_linked", "activity_linked", "agent_linked", "version_linked"],
      "metrics": ["provenance_coverage", "broken_link_rate"],
      "failure_modes": ["orphan_knowledge", "broken_provenance", "unversioned_mutation"],
      "explanation_requirements": ["show_source_fragment", "show_activity", "show_actor"],
      "status": "draft"
    },
    {
      "id": "METHOD-SENIOR-REVIEW-001",
      "name": "Independent Senior Review",
      "goal": "Проверить значимые или неопределённые выводы независимым старшим аналитическим контуром.",
      "inputs": ["candidate_knowledge_package", "evidence_map", "method_trace"],
      "outputs": ["review_decision", "corrections", "request_more_evidence"],
      "source_refs": ["STD-ISO-42001-2024-RU", "STD-RU-59276-2020", "NIST-AI-RMF-1"],
      "checks": ["reviewer_separation", "evidence_access", "decision_reason_recorded"],
      "metrics": ["correction_rate", "false_accept_rate", "rework_rate"],
      "failure_modes": ["same_model_self_confirmation", "review_without_evidence", "silent_override"],
      "explanation_requirements": ["show_decision", "show_changed_items", "show_reason_codes"],
      "status": "draft"
    },
    {
      "id": "METHOD-KB-MUTATION-001",
      "name": "Controlled KB Mutation",
      "goal": "Вносить изменения в KB только как версионируемые и проверяемые события.",
      "inputs": ["approved_change_set", "review_decision", "current_kb_version"],
      "outputs": ["new_kb_version", "audit_event", "superseded_links"],
      "source_refs": ["STD-ISO-30401-2020-RU", "W3C-PROV-O", "BOOK-KLEPPMANN-DDIA"],
      "checks": ["no_destructive_overwrite", "version_created", "audit_event_created", "rollback_possible"],
      "metrics": ["mutation_trace_coverage", "rollback_success_rate"],
      "failure_modes": ["silent_update", "lost_history", "unreviewed_publish"],
      "explanation_requirements": ["show_before_after", "show_approver", "show_reason"],
      "status": "draft"
    }
  ]
}