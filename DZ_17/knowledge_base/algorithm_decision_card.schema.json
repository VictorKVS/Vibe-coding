{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alina.local/schemas/algorithm_decision_card.schema.json",
  "title": "ALINA Algorithm Decision Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "version",
    "status",
    "problem",
    "applicability",
    "inputs",
    "outputs",
    "procedure",
    "alternatives",
    "criteria",
    "decision",
    "source_refs",
    "explanation"
  ],
  "properties": {
    "schema_version": {"const": "alina-algorithm-decision-card-v1"},
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "experimental", "verified", "deprecated", "superseded"]},
    "problem": {"type": "string", "minLength": 1},
    "applicability": {"type": "array", "items": {"type": "string"}},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "procedure": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "action"],
        "properties": {
          "step": {"type": "integer", "minimum": 1},
          "action": {"type": "string"},
          "source_refs": {"type": "array", "items": {"type": "string"}},
          "checks": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "formula": {
      "type": ["object", "null"],
      "properties": {
        "expression": {"type": "string"},
        "normalization": {"type": "string"},
        "calibration_status": {"enum": ["not_applicable", "expert_estimate", "benchmark_calibrated"]}
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "eligible": {"type": "boolean"},
          "hard_blockers": {"type": "array", "items": {"type": "string"}},
          "score": {"type": ["number", "null"]}
        }
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "weight", "weight_origin"],
        "properties": {
          "id": {"type": "string"},
          "description": {"type": "string"},
          "weight": {"type": "number", "minimum": 0, "maximum": 1},
          "weight_origin": {"enum": ["requirement", "benchmark", "domain_policy", "system_analyst", "security_requirement", "operator_override"]},
          "reason": {"type": "string"},
          "source_refs": {"type": "array", "items": {"type": "string"}},
          "calibration_status": {"enum": ["expert_estimate", "benchmark_calibrated"]}
        }
      }
    },
    "decision": {
      "type": "object",
      "required": ["selected_alternative", "reason", "review_status"],
      "properties": {
        "selected_alternative": {"type": "string"},
        "reason": {"type": "string"},
        "review_status": {"enum": ["pending", "approved", "rejected", "needs_more_evidence"]},
        "reviewed_by": {"type": "array", "items": {"type": "string"}},
        "supersedes": {"type": ["string", "null"]}
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "title", "locator_status", "idea_used"],
        "properties": {
          "source_id": {"type": "string"},
          "title": {"type": "string"},
          "locator_type": {"enum": ["clause", "subclause", "section", "chapter", "page", "theorem", "algorithm", "url", "unknown"]},
          "locator": {"type": ["string", "null"]},
          "locator_status": {"enum": ["verified", "pending_verification"]},
          "idea_used": {"type": "string"},
          "quotation": {"type": ["string", "null"]}
        }
      }
    },
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "dataset": {"type": "string"},
          "metrics": {"type": "object"},
          "result": {"type": "string"}
        }
      }
    },
    "failure_modes": {"type": "array", "items": {"type": "string"}},
    "security_constraints": {"type": "array", "items": {"type": "string"}},
    "explanation": {
      "type": "object",
      "required": ["what", "why", "why_not_others", "what_changes_decision"],
      "properties": {
        "what": {"type": "string"},
        "why": {"type": "string"},
        "why_not_others": {"type": "array", "items": {"type": "string"}},
        "what_changes_decision": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
