{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alina.local/schemas/candidate-knowledge-package.schema.json",
  "title": "ALINA Candidate Knowledge Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "case_id",
    "profile",
    "sources",
    "entities",
    "claims",
    "fact_candidates",
    "relation_candidates",
    "event_candidates",
    "hypotheses",
    "contradictions",
    "open_questions",
    "provenance_index",
    "quality_metrics",
    "requested_review"
  ],
  "properties": {
    "schema_version": {"const": "alina-candidate-package-v1"},
    "package_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "minLength": 1},
    "source_summary": {"type": "string"},
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceRef"}
    },
    "observations_summary": {"type": "object"},
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidenceRef"}
    },
    "entities": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "fact_candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "relation_candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "event_candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "timeline_candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"},
      "default": []
    },
    "hypotheses": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "contradictions": {
      "type": "array",
      "items": {"$ref": "#/$defs/contradiction"}
    },
    "open_questions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "provenance_index": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/provenance"}
    },
    "quality_metrics": {
      "type": "object",
      "required": ["candidate_count", "provenance_coverage"],
      "properties": {
        "candidate_count": {"type": "integer", "minimum": 0},
        "provenance_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "mean_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "high_severity_contradictions": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "requested_review": {
      "type": "array",
      "items": {
        "enum": [
          "verify_candidates",
          "resolve_contradictions",
          "check_counter_evidence",
          "check_entity_resolution",
          "check_timeline",
          "check_scope",
          "check_knowledge_state",
          "full_review"
        ]
      }
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "required": ["source_id", "sha256"],
      "properties": {
        "source_id": {"type": "string"},
        "capture_id": {"type": ["string", "null"]},
        "title": {"type": ["string", "null"]},
        "sha256": {"type": "string"},
        "mime_type": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "evidenceRef": {
      "type": "object",
      "required": ["evidence_id", "status", "provenance_id"],
      "properties": {
        "evidence_id": {"type": "string"},
        "observation_id": {"type": ["string", "null"]},
        "status": {"enum": ["candidate", "accepted", "rejected", "needs_review"]},
        "reliability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "provenance_id": {"type": "string"}
      },
      "additionalProperties": true
    },
    "candidate": {
      "type": "object",
      "required": ["id", "kind", "payload", "confidence", "status", "provenance_ids"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string"},
        "payload": {"type": "object"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["proposed", "senior_review", "needs_review", "approved", "rejected", "rework"]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "default": []},
        "provenance_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "extractor": {"type": ["string", "null"]},
        "model_id": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "contradiction": {
      "type": "object",
      "required": ["id", "severity", "candidate_ids", "summary"],
      "properties": {
        "id": {"type": "string"},
        "severity": {"enum": ["low", "medium", "high"]},
        "candidate_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "summary": {"type": "string"},
        "status": {"enum": ["open", "resolved", "needs_human"]}
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["source_id", "capture_id"],
      "properties": {
        "source_id": {"type": "string"},
        "capture_id": {"type": "string"},
        "chunk_id": {"type": ["string", "null"]},
        "page": {"type": ["integer", "null"], "minimum": 1},
        "start_offset": {"type": ["integer", "null"], "minimum": 0},
        "end_offset": {"type": ["integer", "null"], "minimum": 0},
        "region": {"type": ["object", "null"]},
        "audio_span": {"type": ["object", "null"]}
      },
      "additionalProperties": true
    }
  }
}
