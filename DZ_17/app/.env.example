# ALINA model gateway
# AUTO routing: native local models -> direct GigaChat -> one Mistral reserve -> DEMO.
# OpenAI/Ollama remain optional integrations and are NOT used by AUTO unless
# explicitly added back to ALINA_PROVIDER_ORDER.
ALINA_PROVIDER_ORDER=llamacpp,gigachat,compatible,demo

# -----------------------------------------------------------------------------
# CONTROL PLANE — role tokens are server-side only.
# Never commit real values. The browser asks for the role token when a privileged
# action is performed; the token is kept only in page memory and is not returned
# by /api/admin/config or written to the audit ledger.
# Use different values for separation of duties.
# -----------------------------------------------------------------------------
ALINA_ADMIN_TOKEN=
ALINA_SECURITY_TOKEN=

# Optional database connections. Values remain server-side and are never shown
# in the Control Center.
DATABASE_URL=
POSTGRES_URL=
AUDIT_DATABASE_URL=

# -----------------------------------------------------------------------------
# LOCAL DIRECT MODELS — llama.cpp router, no LM Studio required.
# `npm run dev:models` can start llama-server automatically.
# The launcher first checks LLAMA_SERVER_BIN, then PATH (winget install llama.cpp).
#
# Two source modes are supported:
# 1) LLAMA_MODELS_PRESET — preferred for an existing centralized model zoo.
#    Presets can point to absolute GGUF paths on another drive without copying.
# 2) LLAMA_MODELS_DIR — fallback directory mode for a simple flat local folder.
#
# scripts/configure-existing-model-zoo.ps1 can build a LOCAL-ONLY preset under
# runtime/config from FATHER_MODELS_ROOT (or an auto-detected FATHER_MODELS tree).
# -----------------------------------------------------------------------------
LLAMA_AUTOSTART=1
LLAMA_SERVER_BIN=llama-server.exe
FATHER_MODELS_ROOT=
LLAMA_MODELS_PRESET=
LLAMA_MODELS_DIR=models
LLAMA_MODELS_MAX=1
LLAMA_MODELS_AUTOLOAD=1
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8081
LLAMA_BASE_URL=http://127.0.0.1:8081
LLAMA_CTX_SIZE=8192
LLAMA_PARALLEL=1
LLAMA_GPU_LAYERS=99
# Optional fallback list if model discovery is temporarily unavailable.
LLAMA_MODELS=
# Task routing. Leave blank to use the first discovered local model.
LLAMA_DIALOGUE_MODEL=
LLAMA_SYNTHESIS_MODEL=
LLAMA_ARCHITECTURE_MODEL=
LLAMA_KB_MODEL=
LLAMA_KB_VALIDATE_MODEL=
# Set to an exact model id returned by /v1/models.
LLAMA_VISION_MODEL=
# Optional comma-separated list of additional image-capable model ids.
LLAMA_VISION_MODELS=

# -----------------------------------------------------------------------------
# GigaChat DIRECT API — PRIMARY CLOUD PROVIDER FOR ALINA.
# Store only the Authorization key in .env.local; the server obtains/refreshes
# the short-lived access token automatically. Do not paste the access token here.
# If Node/workerd does not trust the required root CA, set these in .env.local
# so the child dev server receives them at process start.
NODE_EXTRA_CA_CERTS=
SSL_CERT_FILE=
# -----------------------------------------------------------------------------
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Normally model ids are discovered automatically via GET /v1/models.
# Fill these only when you intentionally pin a specific returned model id.
GIGACHAT_MODELS=
GIGACHAT_DIALOGUE_MODEL=
GIGACHAT_SYNTHESIS_MODEL=
GIGACHAT_ARCHITECTURE_MODEL=
GIGACHAT_KB_MODEL=
GIGACHAT_KB_VALIDATE_MODEL=

# -----------------------------------------------------------------------------
# MISTRAL RESERVE — one cloud fallback through the existing OpenAI-compatible
# adapter. Mistral exposes GET /v1/models and POST /v1/chat/completions with
# Bearer authentication; we deliberately pin only one reserve model here.
# Put the real API key only in .env.local.
# -----------------------------------------------------------------------------
COMPATIBLE_BASE_URL=https://api.mistral.ai/v1
COMPATIBLE_API_KEY=
COMPATIBLE_MODELS=mistral-small-latest
COMPATIBLE_LABEL=Mistral Reserve
COMPATIBLE_SITE_URL=
COMPATIBLE_APP_NAME=ALINA
COMPATIBLE_DIALOGUE_MODEL=mistral-small-latest
COMPATIBLE_SYNTHESIS_MODEL=mistral-small-latest
COMPATIBLE_ARCHITECTURE_MODEL=mistral-small-latest
COMPATIBLE_KB_MODEL=mistral-small-latest
COMPATIBLE_KB_VALIDATE_MODEL=mistral-small-latest
COMPATIBLE_VISION_MODEL=
COMPATIBLE_VISION_MODELS=

# -----------------------------------------------------------------------------
# OPTIONAL PROVIDERS — disabled from AUTO routing by default.
# -----------------------------------------------------------------------------

# OpenAI — optional, never commit a real key.
OPENAI_API_KEY=
OPENAI_MODELS=gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol
OPENAI_DIALOGUE_MODEL=gpt-5.6-luna
OPENAI_SYNTHESIS_MODEL=gpt-5.6-terra
OPENAI_ARCHITECTURE_MODEL=gpt-5.6-sol
OPENAI_KB_MODEL=gpt-5.6-terra
OPENAI_KB_VALIDATE_MODEL=gpt-5.6-sol
OPENAI_VISION_MODEL=
OPENAI_VISION_MODELS=

# Optional legacy Ollama provider. Native local mode does not require it.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODELS=
OLLAMA_DIALOGUE_MODEL=
OLLAMA_SYNTHESIS_MODEL=
OLLAMA_ARCHITECTURE_MODEL=
OLLAMA_KB_MODEL=
OLLAMA_KB_VALIDATE_MODEL=
OLLAMA_VISION_MODEL=
OLLAMA_VISION_MODELS=
