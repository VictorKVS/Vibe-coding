# ALINA model gateway
# AUTO tries providers in this order. Reorder without changing application code.
ALINA_PROVIDER_ORDER=openai,compatible,ollama,demo

# OpenAI — never commit a real key.
OPENAI_API_KEY=
OPENAI_MODELS=gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol
# Optional task routing. Each value must also be present in OPENAI_MODELS.
OPENAI_DIALOGUE_MODEL=gpt-5.6-luna
OPENAI_SYNTHESIS_MODEL=gpt-5.6-terra
OPENAI_ARCHITECTURE_MODEL=gpt-5.6-sol
OPENAI_KB_MODEL=gpt-5.6-terra
OPENAI_KB_VALIDATE_MODEL=gpt-5.6-sol
# Set explicitly to a model from OPENAI_MODELS that actually accepts image input.
OPENAI_VISION_MODEL=

# Any OpenAI-compatible endpoint (OpenRouter, LM Studio, vLLM, corporate gateway, etc.).
# Base URL must end before /chat/completions, for example https://provider.example/api/v1
COMPATIBLE_BASE_URL=
COMPATIBLE_API_KEY=
COMPATIBLE_MODELS=
COMPATIBLE_LABEL=OpenAI-compatible
COMPATIBLE_SITE_URL=
COMPATIBLE_APP_NAME=Wild Ideas
COMPATIBLE_DIALOGUE_MODEL=
COMPATIBLE_SYNTHESIS_MODEL=
COMPATIBLE_ARCHITECTURE_MODEL=
COMPATIBLE_KB_MODEL=
COMPATIBLE_KB_VALIDATE_MODEL=
COMPATIBLE_VISION_MODEL=

# Ollama. Localhost works only when the app server can reach the same machine.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODELS=
OLLAMA_DIALOGUE_MODEL=
OLLAMA_SYNTHESIS_MODEL=
OLLAMA_ARCHITECTURE_MODEL=
OLLAMA_KB_MODEL=
OLLAMA_KB_VALIDATE_MODEL=
OLLAMA_VISION_MODEL=
