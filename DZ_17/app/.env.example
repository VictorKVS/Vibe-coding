# ALINA model gateway
# AUTO tries providers in this order. Native mode first: local llama.cpp + direct GigaChat.
ALINA_PROVIDER_ORDER=llamacpp,gigachat,openai,compatible,ollama,demo

# -----------------------------------------------------------------------------
# LOCAL DIRECT MODELS — llama.cpp router, no LM Studio required.
# `npm run dev:models` can start llama-server automatically.
# Put GGUF models into LLAMA_MODELS_DIR. llama.cpp router exposes /v1/models and
# dynamically loads/unloads the selected model.
# -----------------------------------------------------------------------------
LLAMA_AUTOSTART=1
LLAMA_SERVER_BIN=runtime/llama/llama-server.exe
LLAMA_MODELS_DIR=models
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8081
LLAMA_BASE_URL=http://127.0.0.1:8081
LLAMA_CTX_SIZE=8192
LLAMA_PARALLEL=1
LLAMA_GPU_LAYERS=99
# Optional fallback list if model discovery is temporarily unavailable.
LLAMA_MODELS=
# Task routing. Leave blank to use the first discovered local model.
LLAMA_DIALOGUE_MODEL=
LLAMA_SYNTHESIS_MODEL=
LLAMA_ARCHITECTURE_MODEL=
LLAMA_KB_MODEL=
LLAMA_KB_VALIDATE_MODEL=
# Set to an exact model id returned by /v1/models.
LLAMA_VISION_MODEL=
# Optional comma-separated list of additional image-capable model ids.
LLAMA_VISION_MODELS=

# -----------------------------------------------------------------------------
# GigaChat DIRECT API — no manual access-token handling in the UI.
# Store only the Authorization key in .env.local; server obtains/refreshes the
# 30-minute access token automatically.
# If Node does not trust the required root CA, set NODE_EXTRA_CA_CERTS locally.
# -----------------------------------------------------------------------------
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Optional fallback list; normally models are discovered via GET /v1/models.
GIGACHAT_MODELS=
GIGACHAT_DIALOGUE_MODEL=
GIGACHAT_SYNTHESIS_MODEL=
GIGACHAT_ARCHITECTURE_MODEL=
GIGACHAT_KB_MODEL=
GIGACHAT_KB_VALIDATE_MODEL=

# -----------------------------------------------------------------------------
# Optional providers kept for portability / deployment.
# -----------------------------------------------------------------------------

# OpenAI — never commit a real key.
OPENAI_API_KEY=
OPENAI_MODELS=gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol
OPENAI_DIALOGUE_MODEL=gpt-5.6-luna
OPENAI_SYNTHESIS_MODEL=gpt-5.6-terra
OPENAI_ARCHITECTURE_MODEL=gpt-5.6-sol
OPENAI_KB_MODEL=gpt-5.6-terra
OPENAI_KB_VALIDATE_MODEL=gpt-5.6-sol
OPENAI_VISION_MODEL=
OPENAI_VISION_MODELS=

# Any OpenAI-compatible endpoint. Not required for native local mode.
COMPATIBLE_BASE_URL=
COMPATIBLE_API_KEY=
COMPATIBLE_MODELS=
COMPATIBLE_LABEL=OpenAI-compatible
COMPATIBLE_SITE_URL=
COMPATIBLE_APP_NAME=Wild Ideas
COMPATIBLE_DIALOGUE_MODEL=
COMPATIBLE_SYNTHESIS_MODEL=
COMPATIBLE_ARCHITECTURE_MODEL=
COMPATIBLE_KB_MODEL=
COMPATIBLE_KB_VALIDATE_MODEL=
COMPATIBLE_VISION_MODEL=
COMPATIBLE_VISION_MODELS=

# Optional legacy Ollama provider. Native local mode does not require it.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODELS=
OLLAMA_DIALOGUE_MODEL=
OLLAMA_SYNTHESIS_MODEL=
OLLAMA_ARCHITECTURE_MODEL=
OLLAMA_KB_MODEL=
OLLAMA_KB_VALIDATE_MODEL=
OLLAMA_VISION_MODEL=
OLLAMA_VISION_MODELS=
