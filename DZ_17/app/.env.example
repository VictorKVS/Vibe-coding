# OpenAI — never commit a real key.
OPENAI_API_KEY=
OPENAI_MODELS=gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol
# Optional: model used by AUTO for image + text analysis. Must also be present in OPENAI_MODELS.
OPENAI_VISION_MODEL=

# Any OpenAI-compatible endpoint (for example OpenRouter, LM Studio, vLLM, a company gateway).
# Base URL must end before /chat/completions, for example https://openrouter.ai/api/v1
COMPATIBLE_BASE_URL=
COMPATIBLE_API_KEY=
COMPATIBLE_MODELS=
COMPATIBLE_LABEL=OpenAI-compatible
COMPATIBLE_SITE_URL=
COMPATIBLE_APP_NAME=Wild Ideas
# Optional: vision model used by AUTO. Must also be present in COMPATIBLE_MODELS.
COMPATIBLE_VISION_MODEL=

# Ollama. Localhost works only when the app server can reach the same machine.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODELS=
# Optional: multimodal Ollama model used by AUTO. Must also be present in OLLAMA_MODELS.
OLLAMA_VISION_MODEL=
