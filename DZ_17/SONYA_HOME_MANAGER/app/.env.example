# DEMO: интерфейс работает без LLM, но честно сообщает, что изображение пиксельно не анализировалось.
SONYA_PROVIDER=demo

# Вариант 1 (рекомендуется для быстрого локального старта): Ollama + Qwen2.5-VL
# SONYA_PROVIDER=ollama
# SONYA_OLLAMA_BASE_URL=http://127.0.0.1:11434
# SONYA_VISION_MODEL=qwen2.5vl:7b

# Вариант 2: локальный OpenAI-compatible vision gateway (например llama.cpp server/router)
# SONYA_PROVIDER=compatible
# SONYA_LLM_BASE_URL=http://127.0.0.1:8080/v1
# SONYA_VISION_MODEL=qwen2.5-vl-7b-instruct-q4_k_m.gguf
# SONYA_LLM_API_KEY=local-no-key
