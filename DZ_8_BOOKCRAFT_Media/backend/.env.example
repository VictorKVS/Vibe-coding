# Separate multiple model roots with ; on Windows.
BOOKCRAFT_MODEL_ROOTS=C:\Users\1\.lmstudio\models

# Local whisper.cpp only. Never commit real secrets or tokens.
WHISPER_CPP_EXE=C:\path\to\whisper-cli.exe
WHISPER_MODEL_PATH=C:\path\to\ggml-large-v3-turbo.bin

# Optional online profiles are configured separately.
# GIGACHAT_ACCESS_TOKEN=

# Local ComfyUI API (Comfy Desktop instance)
BOOKCRAFT_COMFYUI_BASE_URL=http://127.0.0.1:8188
