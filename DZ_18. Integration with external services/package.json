{
  "name": "father-content-generator-dz18",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node server/index.mjs",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "start": "node server/index.mjs --production",
    "preview": "vite preview"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
