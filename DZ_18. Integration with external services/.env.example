# Browser-safe public configuration.
VITE_APP_NAME=FATHER Content Generator
VITE_DEMO_MODE=true

# Server-side only. Never expose this value as VITE_*.
HEYGEN_API_KEY=
HEYGEN_BASE_URL=https://api.heygen.com

# Local backend port. Vite proxies /api to 5190 in development.
PORT=5190

# LLM provider for Newsletter / Podcast. Server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com

# Future provider:
# ELEVENLABS_API_KEY=
