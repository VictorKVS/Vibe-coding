const DEFAULT_BASE_URL =
  "http://127.0.0.1:8088";

const DEFAULT_MODEL =
  "Ministral 3 8B Instruct Q4";


export function localLlmHealth() {
  return {
    provider: "local",
    configured: true,

    model:
      process.env.LOCAL_LLM_NAME ||
      DEFAULT_MODEL,

    runtime:
      "llama.cpp server",

    baseUrl:
      process.env.LOCAL_LLM_BASE_URL ||
      DEFAULT_BASE_URL,

    structuredOutput:
      true,

    private:
      true,
  };
}


export async function generateLocalStructured({
  prompt,
  input,
  kind = "newsletter",
}) {
  const baseUrl =
    process.env.LOCAL_LLM_BASE_URL ||
    DEFAULT_BASE_URL;

  const model =
    process.env.LOCAL_LLM_NAME ||
    DEFAULT_MODEL;


  const factualGuard = [
    "",
    "FACTUAL GUARD:",
    "Use only facts explicitly present in INPUT.",
    "Never invent pricing, free access, trial conditions, dates, links, integrations, metrics, certifications, clients or capabilities.",
    "If the input does not contain a link, do not tell the reader to follow a link.",
    "If the input does not say the product is free, do not use words meaning free, no-cost or complimentary.",
    "Do not mention integrations unless they are explicitly supplied in INPUT.",
  ].join("\n");


  const systemPrompt = [
    prompt.instructions,

    factualGuard,

    "",
    "OUTPUT:",
    "Return one object matching the supplied schema.",
    "No Markdown.",
    "No prose outside the object.",
  ].join("\n");


  let response;

  try {
    response = await fetch(
      `${baseUrl}/v1/chat/completions`,
      {
        method: "POST",

        headers: {
          "Content-Type":
            "application/json; charset=utf-8",
        },

        body: JSON.stringify({
          model,

          messages: [
            {
              role: "system",
              content: systemPrompt,
            },
            {
              role: "user",
              content: JSON.stringify(
                input,
                null,
                2
              ),
            },
          ],

          response_format: {
            type: "json_schema",
            schema: prompt.schema,
          },

          temperature: 0.2,

          max_tokens:
            kind === "podcast"
              ? 1800
              : 1200,

          stream: false,
        }),
      }
    );
  }
  catch (cause) {
    const error =
      new Error(
        `Local LLM server unavailable: ${cause.message}`
      );

    error.statusCode = 503;
    error.provider = "local";
    error.cause = cause;

    throw error;
  }


  const raw =
    await response.text();

  let payload;

  try {
    payload =
      raw
        ? JSON.parse(raw)
        : {};
  }
  catch {
    payload = {
      raw,
    };
  }


  if (!response.ok) {
    const error =
      new Error(
        payload?.error?.message ||
        payload?.error ||
        `Local LLM HTTP ${response.status}`
      );

    error.statusCode =
      response.status;

    error.provider =
      "local";

    error.upstream = {
      status:
        response.status,

      preview:
        raw.slice(
          0,
          1500
        ),
    };

    throw error;
  }


  const content =
    payload?.choices?.[0]
      ?.message?.content;


  if (
    typeof content !== "string" ||
    !content.trim()
  ) {
    const error =
      new Error(
        "Local LLM returned no message content."
      );

    error.statusCode = 502;
    error.provider = "local";

    throw error;
  }


  const data =
    parseStructuredJson(
      content
    );


  validateContract(
    data,
    prompt.schema
  );


  validateFacts(
    data,
    input
  );


  return {
    provider: "local",
    model,

    promptId:
      prompt.id,

    promptVersion:
      prompt.version,

    data,
  };
}


function parseStructuredJson(raw) {
  let text =
    String(raw || "")
      .trim();


  text = text
    .replace(
      /^```(?:json)?\s*/i,
      ""
    )
    .replace(
      /\s*```$/,
      ""
    )
    .trim();


  try {
    return JSON.parse(
      text
    );
  }
  catch {
  }


  const start =
    text.indexOf("{");

  const end =
    text.lastIndexOf("}");


  if (
    start < 0 ||
    end <= start
  ) {
    throwProvider(
      "Local model output contains no JSON object.",
      {
        preview:
          text.slice(
            0,
            1500
          ),
      }
    );
  }


  const candidate =
    text.slice(
      start,
      end + 1
    );


  try {
    return JSON.parse(
      candidate
    );
  }
  catch {
    throwProvider(
      "Local model returned invalid JSON.",
      {
        preview:
          candidate.slice(
            0,
            1500
          ),
      }
    );
  }
}


function validateContract(
  data,
  schema
) {
  if (
    !data ||
    typeof data !== "object" ||
    Array.isArray(data)
  ) {
    throwProvider(
      "Structured output root must be an object."
    );
  }


  const required =
    Array.isArray(
      schema?.required
    )
      ? schema.required
      : [];


  for (
    const key
    of required
  ) {
    if (
      !(key in data)
    ) {
      throwProvider(
        `Missing required field: ${key}`
      );
    }


    if (
      typeof data[key] === "string" &&
      !data[key].trim()
    ) {
      throwProvider(
        `Empty required field: ${key}`
      );
    }
  }
}


function validateFacts(
  data,
  input
) {
  const supplied =
    JSON.stringify(
      input
    ).toLowerCase();


  const generated =
    JSON.stringify(
      data
    ).toLowerCase();


  const freeClaims = [
    "???????",
    "free trial",
    "free access",
    "no-cost",
  ];


  if (
    !supplied.includes("???????") &&
    !supplied.includes("free")
  ) {
    for (
      const marker
      of freeClaims
    ) {
      if (
        generated.includes(
          marker
        )
      ) {
        throwProvider(
          "Factual guard rejected an unsupported free-access claim."
        );
      }
    }
  }


  if (
    !supplied.includes("http://") &&
    !supplied.includes("https://") &&
    (
      generated.includes(
        "????????? ?? ??????"
      ) ||
      generated.includes(
        "?? ??????"
      )
    )
  ) {
    throwProvider(
      "Factual guard rejected an unsupported link instruction."
    );
  }
}


function throwProvider(
  message,
  upstream
) {
  const error =
    new Error(
      message
    );

  error.statusCode = 502;
  error.provider = "local";

  if (upstream) {
    error.upstream =
      upstream;
  }

  throw error;
}
